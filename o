#!/bin/sh
# o: find a file by name and open it.
# https://github.com/rdubar/opener  (MIT)

set -u

usage() {
  cat <<'EOF'
o: find a file by name and open it.

  o decides          one match: opens it. Several: lists them, newest first,
                     and asks for a number.
  o review guide     every word must appear in the file name
  o -p notes         print the matching paths only (also what happens when
                     the output goes to a pipe or a file)
  o -a old plan      also search folders named archive or _archive
  o -w notes         also search git worktrees (extra copies of a repo)

Settings (environment variables, all optional):
  O_ROOTS   folders to search, separated by ':'   (default: $HOME)
  O_OPEN    command that opens a file, e.g. "code -g"
            (default: $VISUAL, then $EDITOR, then open / xdg-open,
            else just print the path)
  O_PINS    a file; any worktree whose path appears in it is searched anyway
  O_MAX     how many matches to list              (default: 25)

Uses fd (or fdfind) if installed: fast, and skips .gitignored files.
Otherwise uses find. Matching ignores case. Filenames containing a newline
are not supported.
EOF
}

die() { echo "o: $*" >&2; exit 1; }

archive=0 worktrees=0 printonly=0
while [ $# -gt 0 ]; do
  case $1 in
    -a) archive=1 ;;
    -w) worktrees=1 ;;
    -p) printonly=1 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -?*) echo "o: unknown option $1 (try o -h)" >&2; exit 2 ;;
    *) break ;;
  esac
  shift
done
[ $# -gt 0 ] || { usage >&2; exit 2; }

# Output going to a pipe or file: behave like -p, never prompt or open.
[ -t 1 ] || printonly=1

max=${O_MAX:-25}
case $max in ''|*[!0-9]*|0) die "O_MAX must be a positive number" ;; esac

query=$*

# Words: lower-case, non-empty.
words=$(printf '%s\n' "$@" | awk 'NF' | tr '[:upper:]' '[:lower:]')
[ -n "$words" ] || die "nothing to search for"
first=$(printf '%s\n' "$words" | head -n 1)

fd=
if command -v fd >/dev/null 2>&1; then fd=fd
elif command -v fdfind >/dev/null 2>&1; then fd=fdfind   # Debian, Raspberry Pi OS
fi

skip="node_modules .git __pycache__ .venv venv .cache .Trash graphify-out"
[ $archive -eq 1 ] || skip="$skip archive _archive"

# Private temporary folder (no predictable names in a shared /tmp).
tdir=$(mktemp -d "${TMPDIR:-/tmp}/o.XXXXXX") || die "can't make a temporary folder"
trap 'rm -rf "$tdir"' 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
tmp=$tdir/hits
: > "$tmp" && : > "$tdir/wt" || die "can't write to $tdir"

# A glob that matches the first word literally (for find).
globword=$(printf '%s' "$first" | sed 's/[][*?\\]/\\&/g')

# Is git worktree $1 mentioned in the O_PINS file? (Exact folder, or a path in it.)
pinned() {
  [ -n "${O_PINS:-}" ] && [ -f "$O_PINS" ] || return 1
  O_A=$1 O_B=$1
  case $1 in "$HOME"/*) O_B="~${1#"$HOME"}" ;; esac
  export O_A O_B
  awk '
    function has(line, p,   i, c) {
      i = index(line, p); if (!i) return 0
      c = substr(line, i + length(p), 1)
      return c == "" || c !~ /[A-Za-z0-9._-]/
    }
    has($0, ENVIRON["O_A"]) || has($0, ENVIRON["O_B"]) { found = 1; exit }
    END { exit !found }' "$O_PINS"
}

home_real=$(cd -- "$HOME" 2>/dev/null && pwd -P) || home_real=$HOME
searched=0
old_ifs=$IFS
IFS=:
set -f
for root in ${O_ROOTS:-$HOME}; do
  set +f
  IFS=$old_ifs
  # A literal ~ left in O_ROOTS by quoting: expand it.
  # shellcheck disable=SC2088
  case $root in
    '') IFS=:; set -f; continue ;;
    '~') root=$HOME ;;
    '~/'*) root=$HOME/${root#'~/'} ;;
  esac
  if [ ! -d "$root" ]; then
    echo "o: skipping $root (not a folder)" >&2
    IFS=:; set -f; continue
  fi
  # Absolute, so a root can never be mistaken for an option or a find expression.
  root=$(cd -- "$root" && pwd -P) || { IFS=:; set -f; continue; }
  searched=1

  # macOS: never crawl ~/Library (huge, and full of permission prompts).
  lib=
  [ "$root" = "$home_real" ] && [ -d "$root/Library" ] && lib=1

  # 1. Find git worktrees first (a worktree's .git is a file), so the search
  #    can skip them instead of crawling them and throwing the results away.
  : > "$tdir/wt.here"
  if [ $worktrees -eq 0 ]; then
    if [ -n "$fd" ]; then
      set -- --hidden --no-ignore --type f --max-depth 6 \
        --exclude '.*/' --exclude node_modules
      [ -n "$lib" ] && set -- "$@" --exclude /Library
      $fd "$@" --absolute-path '^\.git$' "$root" 2>/dev/null
    else
      set -- -name node_modules -o -name '.?*'
      [ -n "$lib" ] && set -- "$@" -o -path "$root/Library"
      find "$root" -mindepth 1 -maxdepth 4 -type d \( "$@" \) -prune \
        -o -name .git -type f -print 2>/dev/null
    fi | while IFS= read -r g; do
      d=${g%/.git}
      [ "$d" = "$root" ] && continue   # searching inside a worktree: keep it
      # Worktrees point into .git/worktrees/; submodules (also a .git file) don't.
      grep -q '/worktrees/' "$g" 2>/dev/null || continue
      pinned "$d" || printf '%s\n' "$d"
    done > "$tdir/wt.here"
    cat "$tdir/wt.here" >> "$tdir/wt"
  fi

  # 2. Search file names (case-insensitive, literal).
  if [ -n "$fd" ]; then
    set --
    for s in $skip; do set -- "$@" --exclude "$s"; done
    [ -n "$lib" ] && set -- "$@" --exclude /Library
    while IFS= read -r d; do
      set -- "$@" --exclude "${d#"$root"}"   # leading / anchors it to the root
    done < "$tdir/wt.here"
    $fd --type f --ignore-case --fixed-strings --absolute-path "$@" \
      -- "$first" "$root" 2>/dev/null
  else
    set --
    for s in $skip; do set -- "$@" -o -name "$s"; done
    shift
    [ -n "$lib" ] && set -- "$@" -o -path "$root/Library"
    while IFS= read -r d; do set -- "$@" -o -path "$d"; done < "$tdir/wt.here"
    find "$root" \( -type d \( "$@" -o -name '.?*' \) \) -prune -o \
      -type f -iname "*$globword*" -print 2>/dev/null
  fi >> "$tmp"
  IFS=:
  set -f
done
set +f
IFS=$old_ifs
[ $searched -eq 1 ] || die "no folders to search (check O_ROOTS)"

# Every word must be in the file name; drop worktrees; drop duplicates.
printf '%s\n' "$words" > "$tdir/words"
sed 's|$|/|' "$tdir/wt" > "$tdir/wt.slash"
hits=$(awk -v wordfile="$tdir/words" -v wtfile="$tdir/wt.slash" '
  BEGIN {
    while ((getline l < wordfile) > 0) w[++n] = l
    while ((getline l < wtfile) > 0) wt[++m] = l
  }
  {
    name = tolower($0); sub(/.*\//, "", name)
    for (i = 1; i <= n; i++) if (index(name, w[i]) == 0) next
    for (j = 1; j <= m; j++) if (index($0, wt[j]) == 1) next
    if (!seen[$0]++) print
  }' "$tmp")

[ -n "$hits" ] || die "no file matches: $query"

# Newest first, by modification time. stat runs in batches; sorting after
# makes the batch size irrelevant.
if stat -c '%Y %n' / >/dev/null 2>&1; then set -- -c '%Y %n'   # GNU, busybox
else set -- -f '%m %N'                                          # BSD, macOS
fi
hits=$(printf '%s\n' "$hits" | tr '\n' '\0' | xargs -0 stat "$@" -- 2>/dev/null |
       sort -t ' ' -k1,1nr -k2 | cut -d ' ' -f 2-)
[ -n "$hits" ] || die "matching files vanished while searching"
count=$(printf '%s\n' "$hits" | wc -l | tr -d ' ')

if [ $printonly -eq 1 ]; then
  printf '%s\n' "$hits"
  exit 0
fi

# For display only: shorten $HOME to ~ and drop terminal control characters.
show() {
  case $1 in
    "$HOME"/*) printf '~%s\n' "${1#"$HOME"}" ;;
    *) printf '%s\n' "$1" ;;
  esac | LC_ALL=C tr -d '\001-\037\177'
}

open_file() {
  # O_OPEN, VISUAL and EDITOR may hold a command with arguments ("code -g").
  if [ -n "${O_OPEN:-}" ]; then set -f; $O_OPEN "$1"
  elif [ -n "${VISUAL:-}" ]; then set -f; $VISUAL "$1"
  elif [ -n "${EDITOR:-}" ]; then set -f; $EDITOR "$1"
  elif [ "$(uname)" = Darwin ] && command -v open >/dev/null 2>&1; then open "$1"
  elif [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$1" >/dev/null 2>&1 &
  else show "$1"
  fi
}

if [ "$count" -eq 1 ]; then
  show "$hits"
  open_file "$hits"
  exit
fi

printf '%s\n' "$hits" | head -n "$max" | while IFS= read -r f; do
  i=$((${i:-0} + 1))
  printf '%3d  %s\n' "$i" "$(show "$f")"
done
shown=$count
if [ "$count" -gt "$max" ]; then
  echo "  ... $((count - max)) more; add a word to narrow it"
  shown=$max
fi

printf 'Open which? (number, Enter to quit) ' >&2
read -r n < /dev/tty 2>/dev/null || { echo >&2; exit 0; }
[ -n "$n" ] || exit 0
case $n in
  *[!0-9]*|??????*) die "not a number from the list: $n" ;;
esac
[ "$n" -ge 1 ] && [ "$n" -le "$shown" ] || die "pick a number from 1 to $shown"
open_file "$(printf '%s\n' "$hits" | sed -n "${n}p")"
